generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm, unaccent]
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OtpType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  PHONE_AUTH
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  GOVERNMENT_ID
  SELFIE
  PROOF_OF_ADDRESS
}

enum ServiceStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum ServiceType {
  LABOUR
  MATERIALS
  BOTH
}

enum PricingModel {
  FIXED_PRICE
  CUSTOM_QUOTE
}

enum ResponseTime {
  WITHIN_30_MIN
  WITHIN_1_HOUR
  WITHIN_FEW_HOURS
  WITHIN_24_HOURS
  WITHIN_2_3_DAYS
}

enum QuotationStatus {
  DRAFT
  PENDING
  NEGOTIATING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum QuotationItemType {
  LABOUR
  MATERIAL
  TRANSPORT
  ADDITIONAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACCEPTED
  SCHEDULED
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  CANCELLED
  DISPUTED
  CLOSED // reached only via review submission or dispute resolution — never via the generic status PATCH
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  SYSTEM
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum NotificationType {
  // ── Messaging ──────────────────────────────────────────────────────────
  NEW_MESSAGE

  // ── Service Requests ───────────────────────────────────────────────────
  SERVICE_REQUEST_SENT // Confirmation to the client who sent the request
  NEW_SERVICE_REQUEST // Notification to the provider who received the request
  REQUEST_ACCEPTED // Provider accepted → notify client
  REQUEST_REJECTED // Provider declined → notify client
  REQUEST_PRICE_ADJUSTED // Provider changed the price → notify client
  REQUEST_PRICE_ACCEPTED // Client accepted the (possibly adjusted) price → notify provider
  REQUEST_PRICE_DECLINED // Client declined the adjusted price → notify provider
  REQUEST_EXPIRED // Request went unanswered past its expiry → notify client

  // ── Quotations ─────────────────────────────────────────────────────────
  NEW_QUOTE
  QUOTE_UPDATED
  QUOTE_ACCEPTED
  QUOTE_REJECTED

  // ── Bookings ───────────────────────────────────────────────────────────
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_ACCEPTED
  BOOKING_SCHEDULED
  BOOKING_IN_PROGRESS
  BOOKING_PARTIALLY_COMPLETED
  BOOKING_COMPLETED
  BOOKING_CANCELLED
  BOOKING_DISPUTED
  DISPUTE_RESOLVED
  CONVERSATION_ARCHIVED

  // ── Tracking ───────────────────────────────────────────────────────────
  ARTISAN_EN_ROUTE
  ARTISAN_ARRIVED
  JOB_STARTED

  // ── Verification & Services ────────────────────────────────────────────
  VERIFICATION_SUBMITTED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  SERVICE_SUBMITTED
  SERVICE_APPROVED
  SERVICE_REJECTED
  SERVICE_SUSPENDED

  // ── Social ─────────────────────────────────────────────────────────────
  NEW_FOLLOWER

  // ── Reviews ────────────────────────────────────────────────────────────
  REVIEW_RECEIVED
  RATING_MILESTONE

  // ── Payments ───────────────────────────────────────────────────────────
  WALLET_FUNDED
  PAYMENT_SUCCESSFUL
  PAYMENT_FAILED
  MATERIAL_FUNDING_REQUIRED
  MATERIAL_FUNDING_COMPLETED
  BOOKING_READY_TO_SCHEDULE
  REFUND_ISSUED
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_COMPLETED
  PAYMENT_RECEIVED
  TRANSFER_FAILED
  TRANSFER_COMPLETED
  ESCROW_HELD
  ESCROW_RELEASED

  // ── System ─────────────────────────────────────────────────────────────
  SYSTEM_MAINTENANCE
  SECURITY_ALERT

  // ── Support ────────────────────────────────────────────────────────────
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_UPDATED
  SUPPORT_TICKET_RESOLVED
  SUPPORT_TICKET_CLOSED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

// ─── Payment Enums ────────────────────────────────────────────────────────────

enum PaymentType {
  LABOUR_ONLY
  MATERIALS_REQUIRED
  FULL_PROJECT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum TransactionType {
  FUNDING
  PAYMENT
  ESCROW_HOLD
  ESCROW_RELEASE
  EARNING_CREDIT
  WITHDRAWAL
  REFUND
  ADJUSTMENT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum UploadPurpose {
  PROFILE_IMAGE
  SERVICE_IMAGE
  PORTFOLIO_MEDIA
  VERIFICATION_DOCUMENT
  CHAT_ATTACHMENT
  DISPUTE_EVIDENCE
  REVIEW_IMAGE
  CATEGORY_ICON
  SERVICE_REQUEST
}

// ─────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  phone               String    @unique
  email               String?   @unique
  passwordHash        String?
  role                UserRole  @default(USER)
  isPhoneVerified     Boolean   @default(true)
  isEmailVerified     Boolean   @default(false)
  isActive            Boolean   @default(true)
  isSuspended         Boolean   @default(false)
  suspendedReason     String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  profile                      UserProfile?
  devices                      UserDevice[]
  refreshTokens                RefreshToken[]
  otpCodes                     OtpCode[]
  verification                 Verification?
  services                     ServiceListing[]
  portfolio                    Portfolio?
  sentMessages                 Message[]                 @relation("SentMessages")
  conversations                ConversationParticipant[]
  quotationsAsProvider         Quotation[]               @relation("ProviderQuotations")
  quotationsAsCustomer         Quotation[]               @relation("CustomerQuotations")
  bookingsAsCustomer           Booking[]                 @relation("CustomerBookings")
  bookingsAsProvider           Booking[]                 @relation("ProviderBookings")
  serviceRequestsAsCustomer    ServiceRequest[]          @relation("CustomerServiceRequests")
  serviceRequestsAsProvider    ServiceRequest[]          @relation("ProviderServiceRequests")
  reviewsGiven                 Review[]                  @relation("ReviewsGiven")
  reviewsReceived              Review[]                  @relation("ReviewsReceived")
  followers                    Follow[]                  @relation("UserFollowers")
  following                    Follow[]                  @relation("UserFollowing")
  savedServices                SavedService[]
  serviceLikes                 ServiceLike[]
  notifications                Notification[]
  notificationPrefs            NotificationPreference?
  disputesRaised               Dispute[]                 @relation("DisputeRaisedBy")
  disputesAsProvider           Dispute[]                 @relation("DisputeProvider")
  uploads                      Upload[]
  auditLogs                    AuditLog[]
  addresses                    Address[]
  trackingAsArtisan            TrackingSession[]         @relation("ArtisanTracking")
  trackingAsCustomer           TrackingSession[]         @relation("CustomerTracking")
  supportTickets               SupportTicket[]
  contentReports               ContentReport[]
  wallet                       Wallet?
  withdrawals                  Withdrawal[]
  payments                     Payment[]
  escrowReservationsAsCustomer EscrowReservation[]       @relation("EscrowCustomer")
  escrowReservationsAsProvider EscrowReservation[]       @relation("EscrowProvider")

  @@index([phone])
  @@index([email])
  @@index([role])
  @@index([isActive, isSuspended])
  @@index([createdAt])
  @@map("users")
}

model UserProfile {
  id              String                                 @id @default(uuid())
  userId          String                                 @unique
  firstName       String?
  lastName        String?
  displayName     String?
  bio             String?
  avatarUrl       String?
  city            String?
  state           String?
  country         String                                 @default("NG")
  latitude        Float?
  longitude       Float?
  location        Unsupported("geography(Point, 4326)")?
  isProvider      Boolean                                @default(false)
  avgRating       Float                                  @default(0)
  totalReviews    Int                                    @default(0)
  completedJobs   Int                                    @default(0)
  completionRate  Float                                  @default(0)
  responseRate    Float                                  @default(0)
  avgResponseTime Int                                    @default(0) // seconds
  travelRadius    Int                                    @default(10) // km
  followersCount  Int                                    @default(0)
  followingCount  Int                                    @default(0)
  createdAt       DateTime                               @default(now())
  updatedAt       DateTime                               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([city, state])
  @@map("user_profiles")
}

model UserDevice {
  id         String   @id @default(uuid())
  userId     String
  deviceId   String
  deviceType String // ios | android | web
  deviceName String?
  fcmToken   String?
  ipAddress  String?
  userAgent  String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("user_devices")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  deviceId  String?
  ipAddress String?
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  code      String
  type      OtpType
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("otp_codes")
}

// ─────────────────────────────────────────
// VERIFICATION
// ─────────────────────────────────────────

model Verification {
  id              String             @id @default(uuid())
  userId          String             @unique
  status          VerificationStatus @default(PENDING)
  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNotes     String?
  rejectionReason String?
  updatedAt       DateTime           @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents VerificationDocument[]

  @@index([userId])
  @@index([status])
  @@map("verifications")
}

model VerificationDocument {
  id             String       @id @default(uuid())
  verificationId String
  documentType   DocumentType
  fileUrl        String
  fileName       String
  fileSize       Int
  mimeType       String
  createdAt      DateTime     @default(now())

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
  @@map("verification_documents")
}

// ─────────────────────────────────────────
// CATEGORIES
// ─────────────────────────────────────────

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  iconUrl     String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[]       @relation("CategoryHierarchy")
  services ServiceListing[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

// ─────────────────────────────────────────
// SERVICES
// ─────────────────────────────────────────

model ServiceListing {
  id                   String                   @id @default(uuid())
  providerId           String
  categoryId           String
  subcategoryId        String?
  title                String
  slug                 String                   @unique
  description          String
  shortDescription     String?
  startingPrice        Float
  minPrice             Float?
  maxPrice             Float?
  serviceRadius        Int                      @default(10)
  serviceType          ServiceType              @default(BOTH)
  responseTime         ResponseTime             @default(WITHIN_1_HOUR)
  pricingModel         PricingModel             @default(FIXED_PRICE)
  materialHandlingFee  Float?
  minimumServiceCharge Float?
  extraCharges         Json?
  whatsIncluded        String?
  whatsNotIncluded     String?
  toolsEquipment       String?
  customerRequirements String?
  isEmergency          Boolean                  @default(false)
  status               ServiceStatus            @default(DRAFT)
  isPublished          Boolean                  @default(false)
  publishedAt          DateTime?
  reviewNotes          String?
  rejectionReason      String?
  reviewedBy           String?
  reviewedAt           DateTime?
  trendingScore        Float                    @default(0)
  engagementScore      Float                    @default(0)
  likesCount           Int                      @default(0)
  savesCount           Int                      @default(0)
  sharesCount          Int                      @default(0)
  viewsCount           Int                      @default(0)
  searchVector         Unsupported("tsvector")?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  deletedAt            DateTime?

  provider        User             @relation(fields: [providerId], references: [id])
  category        Category         @relation(fields: [categoryId], references: [id])
  images          ServiceImage[]
  portfolioItems  PortfolioItem[]
  availability    Availability?
  bookings        Booking[]
  reviews         Review[]
  savedBy         SavedService[]
  likes           ServiceLike[]
  quotations      Quotation[]
  serviceRequests ServiceRequest[]

  @@index([providerId])
  @@index([categoryId])
  @@index([status, isPublished])
  @@index([slug])
  @@index([startingPrice])
  @@index([trendingScore])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("service_listings")
}

model ServiceImage {
  id           String   @id @default(uuid())
  serviceId    String
  url          String
  thumbnailUrl String?
  caption      String?
  sortOrder    Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  service ServiceListing @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_images")
}

// ─────────────────────────────────────────
// PORTFOLIO
// ─────────────────────────────────────────

model Portfolio {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PortfolioItem[]

  @@map("portfolios")
}

model PortfolioItem {
  id           String    @id @default(uuid())
  portfolioId  String?
  serviceId    String?
  title        String?
  description  String?
  mediaUrl     String
  thumbnailUrl String?
  mediaType    MediaType
  isBefore     Boolean   @default(false)
  isAfter      Boolean   @default(false)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())

  portfolio Portfolio?      @relation(fields: [portfolioId], references: [id])
  service   ServiceListing? @relation(fields: [serviceId], references: [id])

  @@index([portfolioId])
  @@index([serviceId])
  @@map("portfolio_items")
}

// ─────────────────────────────────────────
// AVAILABILITY
// ─────────────────────────────────────────

model Availability {
  id                  String    @id @default(uuid())
  serviceId           String    @unique
  isVacationMode      Boolean   @default(false)
  vacationStart       DateTime?
  vacationEnd         DateTime?
  breakStartTime      String?
  breakEndTime        String?
  advanceBookingHours Int       @default(24)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  service  ServiceListing     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  slots    AvailabilitySlot[]
  holidays ProviderHoliday[]

  @@map("availability")
}

model AvailabilitySlot {
  id             String  @id @default(uuid())
  availabilityId String
  dayOfWeek      Int // 0=Sun … 6=Sat
  startTime      String // HH:MM
  endTime        String // HH:MM
  isAvailable    Boolean @default(true)

  availability Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  @@unique([availabilityId, dayOfWeek])
  @@index([availabilityId])
  @@map("availability_slots")
}

model ProviderHoliday {
  id             String   @id @default(uuid())
  availabilityId String
  date           DateTime
  reason         String?
  createdAt      DateTime @default(now())

  availability Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  @@index([availabilityId])
  @@map("provider_holidays")
}

// ─────────────────────────────────────────
// CHAT
// ─────────────────────────────────────────

model Conversation {
  id            String    @id @default(uuid())
  title         String?
  serviceId     String?
  lastMessageAt DateTime?
  lastMessage   String?
  isArchived    Boolean   @default(false)
  archivedAt    DateTime?
  closedReason  String? // COMPLETED | CANCELLED | REJECTED — set on close
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  participants    ConversationParticipant[]
  messages        Message[]
  quotations      Quotation[]
  serviceRequests ServiceRequest[]

  @@index([lastMessageAt])
  @@index([isArchived])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  isRead         Boolean   @default(false)
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  content        String?
  type           MessageType @default(TEXT)
  isDelivered    Boolean     @default(false)
  isRead         Boolean     @default(false)
  deliveredAt    DateTime?
  readAt         DateTime?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User           @relation("SentMessages", fields: [senderId], references: [id])
  media        MessageMedia[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model MessageMedia {
  id           String    @id @default(uuid())
  messageId    String
  url          String
  thumbnailUrl String?
  mediaType    MediaType
  fileName     String?
  fileSize     Int?
  mimeType     String?
  createdAt    DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_media")
}

// ─────────────────────────────────────────
// SERVICE REQUESTS
// ─────────────────────────────────────────
// The structured front door of the request flow: created alongside the
// Conversation when a customer requests a service (description, photos, job
// location, base price). Accepting one auto-generates the Quotation that the
// existing negotiation/booking chain already knows how to carry forward —
// this is additive, not a parallel booking system.

enum ServiceRequestStatus {
  PENDING
  PRICE_UPDATED // artisan adjusted the price — awaiting customer confirmation
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED // a Booking now exists for this request
  CANCELLED // customer withdrew before the provider responded
}

model ServiceRequest {
  id             String               @id @default(uuid())
  conversationId String
  customerId     String
  providerId     String
  serviceId      String
  description    String
  address        String
  latitude       Float
  longitude      Float
  savedAddressId String?
  basePrice      Float
  adjustedPrice  Float?
  priceReason    String?
  declineReason  String?
  status         ServiceRequestStatus @default(PENDING)
  expiresAt      DateTime
  respondedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  conversation Conversation                 @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     User                         @relation("CustomerServiceRequests", fields: [customerId], references: [id])
  provider     User                         @relation("ProviderServiceRequests", fields: [providerId], references: [id])
  service      ServiceListing               @relation(fields: [serviceId], references: [id])
  images       ServiceRequestImage[]
  priceHistory ServiceRequestPriceHistory[]
  booking      Booking?

  @@index([providerId, status])
  @@index([customerId])
  @@index([expiresAt])
  @@index([conversationId])
  @@map("service_requests")
}

model ServiceRequestPriceHistory {
  id               String   @id @default(uuid())
  serviceRequestId String
  previousPrice    Float
  newPrice         Float
  reason           String?
  changedBy        String
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
  @@map("service_request_price_history")
}

model ServiceRequestImage {
  id               String   @id @default(uuid())
  serviceRequestId String
  url              String
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
  @@map("service_request_images")
}

// ─────────────────────────────────────────
// QUOTATIONS
// ─────────────────────────────────────────

model Quotation {
  id                 String          @id @default(uuid())
  conversationId     String
  serviceId          String?
  providerId         String
  customerId         String
  revisionNumber     Int             @default(1)
  parentId           String?
  status             QuotationStatus @default(DRAFT)
  paymentType        PaymentType     @default(LABOUR_ONLY)
  description        String
  labourCost         Float           @default(0)
  materialCost       Float           @default(0)
  transportationCost Float           @default(0)
  additionalCharges  Float           @default(0)
  taxRate            Float           @default(0)
  totalAmount        Float
  notes              String?
  validUntil         DateTime?
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  conversation Conversation    @relation(fields: [conversationId], references: [id])
  service      ServiceListing? @relation(fields: [serviceId], references: [id])
  provider     User            @relation("ProviderQuotations", fields: [providerId], references: [id])
  customer     User            @relation("CustomerQuotations", fields: [customerId], references: [id])
  parent       Quotation?      @relation("QuotationRevisions", fields: [parentId], references: [id])
  revisions    Quotation[]     @relation("QuotationRevisions")
  booking      Booking?
  items        QuotationItem[]

  @@index([conversationId])
  @@index([providerId])
  @@index([customerId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id          String            @id @default(uuid())
  quotationId String
  type        QuotationItemType
  name        String
  description String?
  quantity    Float             @default(1)
  unitPrice   Float
  totalPrice  Float
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

// ─────────────────────────────────────────
// BOOKINGS
// ─────────────────────────────────────────

model Booking {
  id               String        @id @default(uuid())
  customerId       String
  providerId       String
  serviceId        String
  // Exactly one of these two is set — the origin determines which. Enforced
  // in application code (BookingsService), matching this schema's existing
  // convention of no DB-level CHECK constraints.
  quotationId      String?       @unique
  serviceRequestId String?       @unique
  // Canonical price regardless of origin — added so consumers (admin dispute
  // view, mobile) never need to reach through quotation/serviceRequest to
  // find "how much is this booking for".
  totalAmount      Float
  status           BookingStatus @default(PENDING)
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  completionNotes  String?
  providerNotes    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer          User               @relation("CustomerBookings", fields: [customerId], references: [id])
  provider          User               @relation("ProviderBookings", fields: [providerId], references: [id])
  service           ServiceListing     @relation(fields: [serviceId], references: [id])
  quotation         Quotation?         @relation(fields: [quotationId], references: [id])
  serviceRequest    ServiceRequest?    @relation(fields: [serviceRequestId], references: [id])
  review            Review?
  dispute           Dispute?
  trackingSession   TrackingSession?
  escrowReservation EscrowReservation?
  payments          Payment[]

  @@index([customerId])
  @@index([providerId])
  @@index([serviceId])
  @@index([status])
  @@index([scheduledAt])
  @@map("bookings")
}

// ─────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  serviceId  String
  reviewerId String
  providerId String
  rating     Int
  comment    String?
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking  Booking        @relation(fields: [bookingId], references: [id])
  service  ServiceListing @relation(fields: [serviceId], references: [id])
  reviewer User           @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  provider User           @relation("ReviewsReceived", fields: [providerId], references: [id])
  images   ReviewImage[]

  @@index([bookingId])
  @@index([serviceId])
  @@index([providerId])
  @@index([rating])
  @@map("reviews")
}

model ReviewImage {
  id        String   @id @default(uuid())
  reviewId  String
  url       String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_images")
}

// ─────────────────────────────────────────
// SOCIAL
// ─────────────────────────────────────────

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model SavedService {
  id        String   @id @default(uuid())
  userId    String
  serviceId String
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  service ServiceListing @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@index([userId])
  @@map("saved_services")
}

model ServiceLike {
  id        String   @id @default(uuid())
  userId    String
  serviceId String
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  service ServiceListing @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@index([userId])
  @@index([serviceId])
  @@map("service_likes")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  emailEnabled        Boolean  @default(true)
  pushEnabled         Boolean  @default(true)
  newMessage          Boolean  @default(true)
  newQuote            Boolean  @default(true)
  bookingUpdates      Boolean  @default(true)
  verificationUpdates Boolean  @default(true)
  newFollowers        Boolean  @default(true)
  serviceUpdates      Boolean  @default(true)
  marketing           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─────────────────────────────────────────
// DISPUTES
// ─────────────────────────────────────────

model Dispute {
  id          String        @id @default(uuid())
  bookingId   String        @unique
  raisedById  String
  providerId  String
  status      DisputeStatus @default(OPEN)
  reason      String
  description String
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  adminNotes  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  booking  Booking           @relation(fields: [bookingId], references: [id])
  raisedBy User              @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  provider User              @relation("DisputeProvider", fields: [providerId], references: [id])
  evidence DisputeEvidence[]

  @@index([bookingId])
  @@index([raisedById])
  @@index([status])
  @@map("disputes")
}

model DisputeEvidence {
  id          String   @id @default(uuid())
  disputeId   String
  uploadedBy  String
  fileUrl     String
  fileName    String
  fileSize    Int
  mimeType    String
  description String?
  createdAt   DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@map("dispute_evidence")
}

// ─────────────────────────────────────────
// UPLOADS
// ─────────────────────────────────────────

model Upload {
  id        String        @id @default(uuid())
  userId    String
  key       String        @unique
  url       String
  fileName  String
  fileSize  Int
  mimeType  String
  purpose   UploadPurpose
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([purpose])
  @@map("uploads")
}

// ─────────────────────────────────────────
// ADDRESSES
// ─────────────────────────────────────────

enum AddressLabel {
  HOME
  OFFICE
  OTHER
}

model Address {
  id        String       @id @default(uuid())
  userId    String
  label     AddressLabel @default(OTHER)
  name      String? // custom name e.g. "Mum's house"
  address   String // formatted address string
  latitude  Float
  longitude Float
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@map("addresses")
}

// ─────────────────────────────────────────
// TRACKING
// ─────────────────────────────────────────

enum TrackingStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model TrackingSession {
  id                   String         @id @default(uuid())
  bookingId            String         @unique
  artisanId            String
  customerId           String
  status               TrackingStatus @default(ACTIVE)
  startLatitude        Float?
  startLongitude       Float?
  currentLatitude      Float?
  currentLongitude     Float?
  destinationLatitude  Float?
  destinationLongitude Float?
  distanceKm           Float?
  etaMinutes           Int?
  startedAt            DateTime       @default(now())
  completedAt          DateTime?
  updatedAt            DateTime       @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  artisan  User    @relation("ArtisanTracking", fields: [artisanId], references: [id])
  customer User    @relation("CustomerTracking", fields: [customerId], references: [id])

  @@index([bookingId])
  @@index([artisanId])
  @@index([customerId])
  @@index([status])
  @@map("tracking_sessions")
}

// ─────────────────────────────────────────
// SUPPORT
// ─────────────────────────────────────────

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_USER
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  PAYMENT_ISSUE
  SERVICE_ISSUE
  TRACKING_ISSUE
  TECHNICAL_ISSUE
  ACCOUNT_ISSUE
  VERIFICATION_ISSUE
  BOOKING_ISSUE
  FEEDBACK
  OTHER
}

model SupportTicket {
  id         String                @id @default(uuid())
  userId     String
  category   SupportTicketCategory
  subject    String
  message    String
  status     SupportTicketStatus   @default(OPEN)
  priority   String                @default("NORMAL")
  adminNote  String?
  resolvedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("support_tickets")
}

// ─────────────────────────────────────────
// CONTENT REPORTS
// ─────────────────────────────────────────

enum ReportTargetType {
  USER
  SERVICE
  REVIEW
  MESSAGE
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

model ContentReport {
  id           String           @id @default(uuid())
  reportedById String
  targetType   ReportTargetType
  targetId     String
  reason       String
  status       ReportStatus     @default(PENDING)
  adminNote    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  reportedBy User @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([reportedById])
  @@index([targetType, targetId])
  @@index([status])
  @@index([createdAt])
  @@map("content_reports")
}

// ─────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action, resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────
// PAYMENTS & WALLETS
// ─────────────────────────────────────────

model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  balance        Decimal  @default(0) @db.Decimal(18, 2)
  pendingBalance Decimal  @default(0) @db.Decimal(18, 2)
  heldBalance    Decimal  @default(0) @db.Decimal(18, 2)
  currency       String   @default("NGN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            String          @id @default(uuid())
  walletId      String
  type          TransactionType
  amount        Decimal         @db.Decimal(18, 2)
  balanceBefore Decimal         @db.Decimal(18, 2)
  balanceAfter  Decimal         @db.Decimal(18, 2)
  reference     String          @unique
  description   String?
  metadata      Json?
  createdAt     DateTime        @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  bookingId         String?
  quotationId       String?
  paymentType       PaymentType
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(18, 2)
  currency          String        @default("NGN")
  providerName      String        @default("paystack")
  paystackReference String?       @unique
  paystackChannel   String? // card | bank | ussd | bank_transfer | dedicated_nuban
  reference         String        @unique
  failureReason     String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  booking Booking?       @relation(fields: [bookingId], references: [id])
  audits  PaymentAudit[]

  @@index([userId])
  @@index([bookingId])
  @@index([status])
  @@index([paystackReference])
  @@index([createdAt])
  @@map("payments")
}

model EscrowReservation {
  id         String        @id @default(uuid())
  bookingId  String        @unique
  customerId String
  providerId String
  amount     Decimal       @db.Decimal(18, 2)
  status     PaymentStatus @default(PENDING)
  releasedAt DateTime?
  refundedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id])
  customer User    @relation("EscrowCustomer", fields: [customerId], references: [id])
  provider User    @relation("EscrowProvider", fields: [providerId], references: [id])

  @@index([bookingId])
  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@map("escrow_reservations")
}

model Withdrawal {
  id            String           @id @default(uuid())
  userId        String
  amount        Decimal          @db.Decimal(18, 2)
  currency      String           @default("NGN")
  status        WithdrawalStatus @default(PENDING)
  bankName      String
  bankCode      String           @default("")
  accountNumber String
  accountName   String
  reference     String           @unique
  recipientCode String? // Paystack recipient code
  transferCode  String? // Paystack transfer code
  adminNote     String?
  processedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawals")
}

// ─────────────────────────────────────────
// PAYMENT AUDIT LOG
// ─────────────────────────────────────────

enum PaymentAuditEvent {
  INITIALIZED
  VERIFIED
  WEBHOOK_RECEIVED
  ESCROW_CREATED
  ESCROW_RELEASED
  ESCROW_REFUNDED
  REFUND_INITIATED
  TRANSFER_INITIATED
  TRANSFER_COMPLETED
  TRANSFER_FAILED
  MANUAL_ADJUSTMENT
}

model PaymentAudit {
  id        String            @id @default(uuid())
  paymentId String?
  event     PaymentAuditEvent
  data      Json?
  ipAddress String?
  createdAt DateTime          @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([event])
  @@index([createdAt])
  @@map("payment_audits")
}
