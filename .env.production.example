# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=https://wokizy.app
ADMIN_URL=https://admin.wokizy.app
# ─── WebSocket CORS ────────────────────────────────────────────────────────────
# Comma-separated allowed origins for Socket.IO. Defaults to "*" (all origins)
# when unset — fine for local dev, MUST be restricted before production.
WS_ALLOWED_ORIGINS=https://wokizy.app,https://admin.wokizy.app,https://api.wokizy.app

# ─── Database (PostgreSQL + PostGIS) ────────────────────────────────────────────
DATABASE_URL=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ─── JWT ───────────────────────────────────────────────────────────────────────
# These are dev-only secrets — CHANGE BOTH before any production deployment
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
SERVICE_REQUEST_RESPONSE_TIMEOUT_SECONDS=300

# ─── Storage — Cloudflare R2 (S3-compatible) ────────────────────────────────────
# Bucket: wokizi | Console: https://dash.cloudflare.com -> R2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_S3_BUCKET=wokizi
AWS_S3_ENDPOINT=
STORAGE_PUBLIC_URL=

# ─── Firebase (push notifications) ──────────────────────────────────────────────
# Not required for local dev — push notifications are skipped gracefully
FIREBASE_PROJECT_ID=wokizi-b2cf1
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── SMS / Termii ──────────────────────────────────────────────────────────────
# OTP is printed to the console unless TERMII_ENABLED=true AND a real API key
# is set — the two are independent, so a key can sit here ready to go without
# actually being used yet (e.g. while Termii sender ID approval is pending).
TERMII_API_KEY=
TERMII_SENDER_ID=Wokizi
TERMII_ENABLED=false

# ─── Email — Resend (transactional API) ─────────────────────────────────────────
# Registered in code (ResendService) but not currently triggered by any active
# notification flow — safe to leave empty, service no-ops without a key.
RESEND_API_KEY=

# ─── Paystack (payments / withdrawals) ──────────────────────────────────────────
# REQUIRED before production — payments/withdrawals fall back to a dev no-op
# mode only while NODE_ENV != production. Currently unset in this environment.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=POSTGRES_USER=wokizi