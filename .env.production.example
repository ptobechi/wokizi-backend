# ─────────────────────────────────────────────────────────────────────────────
# Copy this to `.env.production` ON THE VPS ONLY — never commit the real file.
# Values here are consumed two ways:
#   - POSTGRES_* are read directly by docker-compose.prod.yml to configure
#     the postgres container itself.
#   - Everything else is passed through to the app container via `env_file`
#     in docker-compose.prod.yml (same variable names as backend/.env).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Postgres container credentials (used by docker-compose.prod.yml directly) ─
POSTGRES_USER=wokizi
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=wokizi_db

# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=https://your-mobile-app-origin
ADMIN_URL=https://admin.your-domain.com

# ─── JWT — generate fresh, don't reuse dev secrets: openssl rand -base64 48 ────
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ─── Storage — Cloudflare R2 ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
STORAGE_PUBLIC_URL=

# ─── Email — Resend ─────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── Firebase (Admin SDK credentials — currently unused for push, kept for future native-token path) ─
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Paystack — REQUIRED for real payments/withdrawals to work ────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ─── Rate limiting ──────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── OTP ────────────────────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ─── SMS / Termii ───────────────────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=Wokizi

# ─── WebSocket CORS — lock this down, do not leave blank in production ────────
WS_ALLOWED_ORIGINS=https://your-mobile-app-origin,https://admin.your-domain.com
