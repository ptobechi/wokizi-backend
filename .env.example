# ─── Application ───────────────────────────────────────────────────────────────
# https://wokizi-045ca9212da0.herokuapp.com/

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:8081
ADMIN_URL=http://localhost:3001

# ─── Database ──────────────────────────────────────────────────────────────────
# This points to the PostGIS container started by docker-compose
DATABASE_URL=postgresql://wokizi:wokizi_secret@localhost:5433/wokizi_db

# ─── JWT ───────────────────────────────────────────────────────────────────────
# These are dev-only secrets — CHANGE BOTH before any production deployment
JWT_ACCESS_SECRET=wokizi_dev_access_secret_min32chars_ok
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=wokizi_dev_refresh_secret_min32chars_ok
JWT_REFRESH_EXPIRES_IN=30d

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# redis-cli -u redis://default:Fp9Xuije49wX4YsHt7U9uhanxMxPFZHH@amiable-zany-comfortable-58906.db.redis.io:14915
