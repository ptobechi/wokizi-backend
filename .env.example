# ─── S3 / Cloudflare R2 ────────────────────────────────────────────────────────
# Bucket: wokizi | Location: Western Europe (WEUR)
# Console: https://dash.cloudflare.com → R2
# MinIO local fallback: minioadmin / minioadmin123 @ http://localhost:9001
# ─── S3 / MinIO (local) ────────────────────────────────────────────────────────
# MinIO is the local S3 replacement. The console is at http://localhost:9001
# Login: minioadmin / minioadmin123
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin123
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=wokizi-media
# AWS_S3_ENDPOINT=http://192.168.100.133:9000


# Your API Token = cfat_RrNfhAKeJBuqXeAaGLrpUj9vzR3L7uAXM922DpDja4dd8560
AWS_ACCESS_KEY_ID=0dcce453cf7fb8beceed6d626ac598ae
AWS_SECRET_ACCESS_KEY=64f9b6dfa0b127351deffb0b3e7a1a78fed03ddecdb49e640ab24a61a0501f70
AWS_REGION=auto
AWS_S3_BUCKET=wokizi
AWS_S3_ENDPOINT=https://6ce72614991acdd3086c817041f66918.r2.cloudflarestorage.com
# Public URL for serving uploaded files — must differ from AWS_S3_ENDPOINT.
# For Cloudflare R2: enable "Public R2.dev URL" in the R2 bucket settings and set this
# to the value shown (e.g. https://pub-xxxx.r2.dev). Or use a custom domain (https://cdn.wokizi.com).
# Without this, fileUrl falls back to the private API endpoint which clients cannot read.
STORAGE_PUBLIC_URL=


# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
