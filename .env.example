# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:8081
ADMIN_URL=http://localhost:3001

# ─── Database (PostgreSQL + PostGIS) ────────────────────────────────────────────
# This points to the PostGIS container started by docker-compose
DATABASE_URL=postgresql://wokizi:wokizi_secret@localhost:5433/wokizi_db

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate real secrets before deploying, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_random_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ─── Storage — Cloudflare R2 (S3-compatible) ────────────────────────────────────
# Console: https://dash.cloudflare.com -> R2 -> Manage API Tokens
# Local dev alternative: MinIO (started by docker-compose) at http://localhost:9001
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
# Public URL for serving uploaded files — must differ from AWS_S3_ENDPOINT.
# For Cloudflare R2: enable "Public R2.dev URL" in the bucket settings, or use
# a custom domain (https://cdn.wokizi.com). Without this, fileUrl falls back
# to the private API endpoint which clients cannot read. Required in production.
STORAGE_PUBLIC_URL=

# ─── Email — Resend (transactional API) ─────────────────────────────────────────
RESEND_API_KEY=

# ─── Firebase (push notifications) ──────────────────────────────────────────────
# Not required for local dev — push notifications are skipped gracefully
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Paystack (payments / withdrawals) ──────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ─── SMS / Termii ──────────────────────────────────────────────────────────────
# OTP is printed to the console unless TERMII_ENABLED=true AND a real API key
# is set — the two are independent, so a key can sit here ready to go without
# actually being used yet (e.g. while Termii sender ID approval is pending).
TERMII_API_KEY=
TERMII_SENDER_ID=Wokizi
TERMII_ENABLED=false

# ─── WebSocket CORS ────────────────────────────────────────────────────────────
# Comma-separated allowed origins for Socket.IO. Defaults to "*" (all origins)
# when unset — fine for local dev, MUST be restricted before production.
WS_ALLOWED_ORIGINS=
